<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>CreamsConsole_utils</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
	<RepositoryUrl>https://github.com/joloboy20071/CreamsConsole-Utilities</RepositoryUrl>
	<Description>A Console Utilities library inspired by spectre console focused on customization and good looking console applications and TUI's 
</Description>
	<Copyright>Creams-productions</Copyright>
	<PackageProjectUrl>https://github.com/joloboy20071/CreamsConsole-Utilities/tree/master</PackageProjectUrl>
	<RepositoryType>git</RepositoryType>
	<Title>Creams Console Utilities</Title>
	<Company>Creams Productions</Company>
	<IncludeSymbols>True</IncludeSymbols>
	<AssemblyVersion>1.0.0.1</AssemblyVersion>
	<FileVersion>1.0.0.1</FileVersion>
	<PackageReleaseNotes>1.3.1 Fixed Bug in Boxrendering not showing Color in box outline</PackageReleaseNotes>
	<PackAsTool>False</PackAsTool>
	<Version>1.3.1</Version>
	<PackageIcon></PackageIcon>
	<PackageTags>Console App;Console Styling;Console Utilities;Utilities;Creams Productions;</PackageTags>
	<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="pics\**" />
    <Compile Remove="Properties\**" />
    <EmbeddedResource Remove="pics\**" />
    <EmbeddedResource Remove="Properties\**" />
    <None Remove="pics\**" />
    <None Remove="Properties\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="LICENSE.txt" />
    <None Remove="README.md" />
  </ItemGroup>

</Project>
